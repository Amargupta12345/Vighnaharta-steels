{
  "name": "vighnaharta-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "chmod +x setup.sh && ./setup.sh",
    "setup:windows": "setup.bat",
    "dev:open": "next dev && open http://localhost:3000",
    "clean": "rm -rf .next node_modules package-lock.json",
    "fresh-install": "npm run clean && npm install",
    "type-check": "tsc --noEmit",
    "export": "next export"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "15.3.5"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "@eslint/eslintrc": "^3"
  }
}
